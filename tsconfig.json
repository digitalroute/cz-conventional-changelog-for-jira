{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "isolatedModules": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
